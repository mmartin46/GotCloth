{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ClothUsers": "Server=${RDS_ENDPOINT};Database=GotClothUsers;User Id=${RDS_USERNAME};Password=${RDS_PASSWORD};Encrypt=True;TrustServerCertificate=True;",
    "Carts": "Server=${RDS_ENDPOINT};Database=Carts;User Id=${RDS_USERNAME};Password=${RDS_PASSWORD};Encrypt=True;TrustServerCertificate=True;"
  },
  "AppOptions": {
    "Layout": "pants"
  },
  "AWS": {
    "S3BucketName": "${S3_BUCKET_NAME}",
    "Region": "${AWS_REGION}",
    "AccessKeyId": "${AWS_ACCESS_KEY_ID}",
    "SecretAccessKey": "${AWS_SECRET_ACCESS_KEY}"
  }
}
